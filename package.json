{
  "name": "after-effects-mcp",
  "version": "1.0.0",
  "description": "MCP server for Adobe After Effects",
  "author": "Rakeshcool",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rakeshcool/aftereffects_live_mcp.git"
  },
  "homepage": "https://github.com/Rakeshcool/aftereffects_live_mcp#readme",
  "bugs": {
    "url": "https://github.com/Rakeshcool/aftereffects_live_mcp/issues"
  },
  "main": "build/index.js",
  "type": "module",
  "scripts": {
    "build": "npm run typecheck && esbuild src/index.ts --bundle --platform=node --format=esm --outfile=build/index.js --packages=external && copyfiles -u 1 \"src/scripts/**/*\" build",
    "start": "node build/index.js",
    "install-bridge": "node install-bridge.js",
    "build:commands": "node scripts/build-commands.mjs",
    "install-cep": "node scripts/build-commands.mjs && node install-cep.js",
    "postinstall": "npm run build",
    "prepublishOnly": "npm run build",
    "check:zod": "node scripts/check-zod.mjs",
    "typecheck": "npm run check:zod && tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.28.0",
    "node-fetch": "^3.3.2",
    "zod": "^3.25.76"
  },
  "overrides": {
    "zod": "$zod"
  },
  "devDependencies": {
    "@types/node": "^20.17.30",
    "copyfiles": "^2.4.1",
    "esbuild": "^0.27.4",
    "typescript": "^5.2.2"
  }
}
